				</element>
				<element kind="staticText" uuid="6a30a09f-d674-441b-8834-0c1824e3924b" x="444" y="57" width="100" height="30" fontName="URDU JAMEEL NASTALAIQ" fontSize="12.0" bold="false" hTextAlign="Right" vTextAlign="Middle">
					<paragraph rightIndent="1"/>
					<text><![CDATA[تاریخ    پیدائش ]]></text>
				</element>
