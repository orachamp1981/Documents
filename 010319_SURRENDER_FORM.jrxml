				<element kind="staticText" uuid="a0c8673a-2659-4ddc-bbdd-c82cc9032b15" x="444" y="117" width="100" height="30" fontName="URDU JAMEEL NASTALAIQ" fontSize="12.0" bold="false" hTextAlign="Right" vTextAlign="Middle">
