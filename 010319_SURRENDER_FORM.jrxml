					<text><![CDATA[جنس ]]></text>
				</element>
			</element>
			<element kind="frame" uuid="499fbdd0-5223-4d5c-bc95-5bc1fcb878de" x="0" y="249" width="555" height="364">
				<element kind="rectangle" uuid="16885077-5a75-4172-b874-60c8fc48e9c4" x="0" y="-3" width="555" height="30" backcolor="#BFE4B7"/>
				<element kind="staticText" uuid="98e19b09-388d-4d7e-af2b-707f92d42f57" x="4" y="0" width="186" height="22" bold="true" hTextAlign="Left" vTextAlign="Middle">
					<text><![CDATA[Perticipant's Declaration]]></text>
				</element>
				<element kind="staticText" uuid="a8b9d03b-e5d5-4f82-bbbd-beb6d76fe870" x="444" y="-3" width="100" height="30" fontName="URDU JAMEEL NASTALAIQ" fontSize="12.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
					<paragraph rightIndent="1"/>
					<text><![CDATA[شریک  کا  اقرار نامہ ]]></text>
					<property name="com.jaspersoft.studio.unit.rightIndent" value="px"/>
				</element>
				<element kind="rectangle" uuid="8e080edc-344f-466a-b05e-98f10fc2458b" x="0" y="27" width="555" height="153" backcolor="#FFFFFF"/>
				<element kind="textField" uuid="89da4bf8-d3cd-4c48-b78f-abd8a118e455" x="290" y="28" width="263" height="152" fontName="URDU JAMEEL NASTALAIQ" hTextAlign="Justified">
					<expression><![CDATA["میں،"  + $F{PARTICIPANT_NAME} + " اوپر ذکر کردہ رکنیت کے شریک کے طورپر میں اس کا اقرار کرتا ہوں کہ میں اس رکنیت سے دستبردار ہونا چاہتا ہوں اور یہ کہ کیش ویلیو مجھے ادا کی جائے، میں اتفاق کرتا ہوں اور یہ تسلیم کرتا ہوں کہ تقریبا" + $F{CASH_VALUE}  + " روپے کی کیش ویلیو کی وصولی پر یا اگلی قیمتوں کی تعین کی تاریخ پر مندرجہ بالا رکینیت کے کامل اور حتمی تصفیہ کے بعد پلان ختم ہوجائے گا اور میرے پاس کوئی تکافل کوریج نہیں ہوگی۔"]]></expression>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
				</element>
				<element kind="textField" uuid="d76d4643-6d6c-4c5d-b676-3663a7997723" x="0" y="28" width="270" height="152" hTextAlign="Justified">
					<expression><![CDATA[$F{HD1}]]></expression>
					<box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="2"/>
				</element>
				<element kind="rectangle" uuid="239a5609-8c4b-405e-b0ed-c9364eea4c29" x="0" y="180" width="555" height="93" backcolor="#FFFFFF"/>
				<element kind="textField" uuid="79dcba73-523f-4ab8-aedf-85511dd9f187" x="290" y="181" width="263" height="92" fontName="URDU JAMEEL NASTALAIQ" hTextAlign="Justified">
					<expression><![CDATA[ "میں اس کو بھی تسلیم کرتا ہوں کہ اوپر بیان کردہ کیش ویلیو کا مدار آخری میسر NAVکی بنیاد پر ہوگا، حقیقی مالیت زیادہ یا کم ہوسکتی ہے، اور اس کا مدار کمپنی کی بنیادی سرمایہ کاری کی کارکردگی پر ہے"]]></expression>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
				</element>
				<element kind="textField" uuid="9c46033b-ba1b-40ae-918e-528d37c4a519" x="0" y="181" width="270" height="91" hTextAlign="Justified">
					<expression><![CDATA[$F{HD2}]]></expression>
					<box padding="2"/>
				</element>
				<element kind="rectangle" uuid="30edddae-d5d9-47c0-aca7-837ecdf76324" x="0" y="272" width="555" height="93" backcolor="#FFFFFF"/>
				<element kind="textField" uuid="086a82a6-22bb-4821-9c2c-4230c119aad1" x="290" y="273" width="263" height="92" fontName="URDU JAMEEL NASTALAIQ" hTextAlign="Justified">
					<expression><![CDATA["مجاز ہونے کی حیثیت سے، میں پاک قطر فیملی تکافل لمیٹڈ کوپلان کے مستقل انخلاء سے متعلق مستقبل کے کسی بھی کلیم کے دعویٰ سے بری الذمہ کرتا ہوں، جوکہ اس رکنیت کی وجہ سے اس کے خلاف کیا جاسکتا ہو"]]></expression>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
				</element>
				<element kind="textField" uuid="a40d9483-4049-4701-85a2-400e6d092530" x="0" y="273" width="270" height="91" hTextAlign="Justified">
					<expression><![CDATA[$F{HD3}]]></expression>
					<box padding="2"/>
				</element>
			</element>
			<element kind="line" uuid="c8b1b416-e6da-4921-ba42-c8dac3786a4f" x="0" y="30" width="555" height="1">
				<property name="com.jaspersoft.studio.unit.height" value="px"/>
			</element>
