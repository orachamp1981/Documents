<!-- Created with Jaspersoft Studio version 7.0.6.final using JasperReports Library version 7.0.6-5d2a603fdc6b3db8f842a83383e594f41891534d  -->
<jasperReport name="Surrender_URDU_FORM" language="java" columnCount="1" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="10" bottomMargin="15" uuid="7d11fbe6-be91-4310-933f-afef4b31e6f1">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PQTIL.jrdax"/>
	<parameter name="DOCUMENT_ID" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[--Surrender Form
select document_id_pk,membership_no,
       'Alteration Request Form to the Membership no. '||membership_no membershipno,
       type_of_plan Product_Rider,
       alteration_no,
       membership_alteration,
       --alteration_id_pk,
       effective_date,
       tot_partial_wd,
       cash_value,
       new_freq_payment,
       new_contribution,       
       pq_acc_no,
       bank_acc_no,
       bank_name,
       participant_name,
       initcap(residential_address||' '||city_name||','||province_name||' '||country_name) residential_address,
       cnic_no,
       dob,
       gender,
       mobile_no,
       residential_contact,
       type_of_plan,
       commencement_date,
       membership_term,
       maturity_date,
       'I, '||participant_name||', as the Participant of the Membership mentioned above, hereby declare that I wish to withdraw this Membership and pay me the cash value. I, agree and acknowledge that on receipt of approximately cash value of Rs. '||cash_value||' or with final amount on next pricing date, in full and final settlement of the above membership, I will have no Takaful cover as the plan will terminate after this withdrawal.' hd1,
'I, also acknowledge that cash value stated above are based on last available NAV. The actual values can be higher or lower than depending on the performance of the underlying investments of the Company.' hd2,
'Being authorized, I hereby give Pak Qatar Family Takaful Limited full and complete discharge of its liabilities and relieve Pak Qatar Family Takaful Limited, of any future claims related to the permanent withdrawal of the plan which could be made against it by virtue of this membership.' hd3,
'Withdrawal Proceeds are subject to Zakat' hd4,
'I, '||participant_name||', as Participant in the '||type_of_plan||', authorize the Wakeel to arrange for the collection and payment of Zakat on my behalf.' hd5,
'I, '||participant_name||', as Participant in the '||type_of_plan||', hereby declare not to deduct Zakat and payment of Zakat will be my responsibility. I am providing the CZ-50 in this regard.' hd6,
'Are you or any of your associate (immediate family member) affiliated with any Political Party, or works for the Judiciary, Armed Forces, Law Enforcement Agency or Bureaucracy in any possible way?If the reply to the aforementioned has been given in affirmation then complete a separate 

Answer:' hd7,
'Do you have any criminal record or have any criminal proceedings pending against you before any adjudicating forum(s) or are you a part of any banned outfit as per the prevailing laws of the Land?

Answer:' hd8,
'Are you in any way engaged in any sort of business activities with the countries being marked as AML non-compliant by the FATF or UN? If yes, then please share the details.

Answer:' hd9,
USER_NAME

  from (select a.document_id_pk,a.document_code membership_no,
               /*(select count(v1.alteration_code)
                  from vu_alteraiion v1
                 where v1.document_code = a.document_code
                   and v1.alteration_id_pk < c.alteration_id_pk)*/0 alteration_no,
                   --c.alteration_id_pk,
               'Withdrawal Request' membership_alteration,
               trunc(sysdate) effective_date,
               (select to_char(nvl(sum(abs(v2.transaction_amount)), 0),'FM999G999G999G990D00')
          from epf_acc_transaction v1, epf_acc_transaction_dtl v2
         where v1.transaction_id_pk = v2.transaction_id_fk
           and v1.transaction_flag = 'W'
           and v1.document_id_fk = a.document_id_pk
           and v2.employee_id_fk = b.employee_id_pk) tot_partial_wd,
           to_char(pkg_epf_calculation.sf_get_cash_value(a.document_id_pk,b.employee_id_pk,a.period_to),'FM999G999G999G990D00') cash_value,
               (select a1.setup_description
                  from vu_setup_category_detail a1
                 where 1 = 1
                   and a1.setup_category_id_pk = 10
                   and a1.setup_dtl_id_pk = b.mode_of_payment_id) new_freq_payment,
                   (select min(y3.DUE_DATE)
          from vu_payment_scheduler y3
         where y3.document_id_fk = a.document_id_pk
           and y3.employee_id_pk = b.employee_id_pk
           and upper(y3.PAYMENT_STATUS) = 'DUE')  next_cont_due_dt,
           (select max(y2.PAID_DATE)
          from vu_payment_scheduler y2
         where y2.document_id_fk = a.document_id_pk
           and y2.employee_id_pk = b.employee_id_pk) last_cont_paid_dt,
                   b.contribution new_contribution,
                   '310700039300001' pq_acc_no,
               b.account_no bank_acc_no,
               a.policy_bank_id,
               (select initcap(b1.bank_name)
               from epf_gen_st_bank b1
               where b1.bank_id_pk = a.policy_bank_id) bank_name,
               initcap(b.emp_title||' '||trim(b.employee_name)) participant_name,
                b.emp_address residential_address,b.city_id_fk,(select c1.city_name from epf_gen_st_city c1 where c1.city_id_pk = b.city_id_fk) city_name,
               c1.province_id_fk,(select pr.province_name from epf_gen_st_province pr where pr.province_id_pk = c1.province_id_fk) province_name,
               p1.country_code, (select c1.setup_description
                  from vu_setup_category_detail c1
                 where 1 = 1
                   and c1.setup_category_id_pk = 25
                   and c1.setup_dtl_id_pk = p1.country_code) country_name,
               b.cnic_no,
               b.dob,
               decode(b.gender,'M','Male','F','Female') gender,
               b.mobile_no,
               b.phone_no residential_contact,
               d.prod_type_name type_of_plan,
               a.period_from commencement_date,
               a.contribution_term membership_term,
               a.period_to maturity_date,
               (SELECT USER_ID
                 FROM SM_USERS SM WHERE USER_ID_PK =1) USER_NAME
               --,c.alteration_type_id_fk
          from epf_uw_document         a,
               epf_uw_employees        b,
               --vu_alteraiion           c,
               epf_gen_st_product_type d,
               epf_gen_st_participant p1,
               epf_gen_st_city c1
         where 1 = 1
           and a.document_id_pk = b.document_id_fk
           --and a.document_code = c.document_code
           and a.product_type_id_fk = d.prod_type_id_pk
           and a.participant_id_fk = p1.participant_id_pk
           and c1.city_id_pk = p1.city_id_fk(+)
           --and b.emp_status_id_fk in (39,821,931) --Inforce,Paid up
           --and c.ALTERATION_ID_PK in (select max(alteration_id_pk) from vu_alteraiion v1 where v1.DOCUMENT_CODE = a.document_code)
           and a.document_id_pk = $P{DOCUMENT_ID}
           )
           
]]></query>
