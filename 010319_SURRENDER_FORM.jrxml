		<band height="731">
			<element kind="frame" uuid="9e576acb-5657-4d7b-ab1e-7aca4f8c3c26" x="0" y="10" width="555" height="255">
				<element kind="rectangle" uuid="cad39bc9-1cd2-4e92-aff0-d44e861532a4" x="0" y="163" width="555" height="92" backcolor="#BFE4B7"/>
				<element kind="rectangle" uuid="957f0db8-392e-4cdf-9b2c-fe2545c2767f" x="0" y="-3" width="555" height="30" backcolor="#BFE4B7"/>
				<element kind="staticText" uuid="43caacba-92a6-4f50-b681-a7b92a157994" x="4" y="0" width="186" height="22" bold="true" hTextAlign="Left" vTextAlign="Middle">
					<text><![CDATA[Zakat]]></text>
				</element>
				<element kind="staticText" uuid="05d5b234-f839-444f-88f8-2dbbf25c2721" x="400" y="-3" width="144" height="30" fontName="URDU JAMEEL NASTALAIQ" fontSize="12.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
					<paragraph rightIndent="1"/>
					<text><![CDATA[زکواہ کٹوتی/ استثنئ کا اجازت نامہ]]></text>
					<property name="com.jaspersoft.studio.unit.rightIndent" value="px"/>
				</element>
				<element kind="rectangle" uuid="9b3cb8d6-6e48-4421-bd50-4379cd60481b" x="0" y="70" width="555" height="93" backcolor="#BFE4B7"/>
				<element kind="rectangle" uuid="ad22a5b4-29e9-4bc5-bfb5-abd59c53a595" x="0" y="27" width="555" height="43" backcolor="#FFFFFF"/>
				<element kind="textField" uuid="60c6a3eb-06ac-4229-a502-825865c83603" mode="Opaque" x="1" y="71" width="209" height="91" backcolor="#BFE4B7" hTextAlign="Justified">
					<expression><![CDATA[$F{HD5}]]></expression>
					<box padding="2"/>
				</element>
				<element kind="staticText" uuid="2085157e-571b-488a-bdf2-009130d6016b" x="339" y="28" width="214" height="42" fontName="URDU JAMEEL NASTALAIQ" hTextAlign="Justified">
					<text><![CDATA[میں موجود بینک اکاؤنٹ میں ادا کرے- جزوی طور پر رقم نکالنے کی آمدن زکوۃ کے ساتھ مشروط ہوگی اور میں اسی وجہ سے یہ اقرار کرتا ہوں کہ]]></text>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
				</element>
				<element kind="rectangle" uuid="3c234485-693f-46b3-a8ec-9bd13e40ee68" mode="Opaque" x="220" y="71" width="120" height="91" backcolor="#FFFFFF">
					<pen lineWidth="0.0"/>
				</element>
				<element kind="rectangle" uuid="701d5ae9-e082-4a5d-ba3f-5b72f5afe096" x="257" y="100" width="47" height="28"/>
				<element kind="staticText" uuid="6f45b872-9b69-434c-9075-8d27eada8fd3" x="339" y="164" width="215" height="91" fontName="URDU JAMEEL NASTALAIQ" fontSize="10.0" hTextAlign="Justified">
					<text><![CDATA[زکوۃ کی کٹوتی اور اس کی ادائیگی میری ذمہ داری
نہیں ہوگی، میں اس حوالے سے -50CZ فراہم کر رہا
ہوں۔]]></text>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
				</element>
				<element kind="textField" uuid="d4757bda-2b1d-49c8-bf20-4f0b3d1dddf0" x="1" y="28" width="280" height="42" hTextAlign="Justified">
					<expression><![CDATA[$F{HD4}]]></expression>
					<box padding="2"/>
				</element>
				<element kind="textField" uuid="617fb845-57c3-4527-9124-22c8d5d6800c" mode="Opaque" x="1" y="164" width="210" height="91" backcolor="#BFE4B7" fontSize="10.0" hTextAlign="Justified">
					<expression><![CDATA[$F{HD6}]]></expression>
					<box padding="2"/>
				</element>
				<element kind="staticText" uuid="66cbbf32-44bf-48f9-a3c6-de46a8495ad1" x="340" y="71" width="215" height="91" fontName="URDU JAMEEL NASTALAIQ" hTextAlign="Justified">
					<text><![CDATA[میری طرف سے زکوۃ کی وصولی اور ادائیگی کا انتظام کیا جائے۔]]></text>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
				</element>
				<element kind="rectangle" uuid="b4a80f3a-4e79-4867-aa8e-cbaf0339fbda" mode="Opaque" x="220" y="164" width="120" height="91" backcolor="#FFFFFF">
					<pen lineWidth="0.0"/>
				</element>
				<element kind="rectangle" uuid="f40dfd7d-c696-4370-b493-e23c721cfaae" x="257" y="193" width="47" height="28"/>
			</element>
			<element kind="frame" uuid="653f4d70-1e8a-4014-878e-2cc921ffd1e0" x="0" y="280" width="555" height="411">
				<element kind="rectangle" uuid="2cf94518-bd01-493f-baeb-4cd2bbe652ef" x="0" y="310" width="555" height="128" backcolor="#BFE4B7"/>
				<element kind="rectangle" uuid="c351e6ed-abf8-434f-b944-b694741dbc68" x="0" y="-3" width="555" height="30" backcolor="#BFE4B7"/>
				<element kind="staticText" uuid="e869a671-393a-4658-81c4-8f5f79f53931" x="4" y="0" width="186" height="22" bold="true" hTextAlign="Left" vTextAlign="Middle">
					<text><![CDATA[AML / CFT Questionnaire]]></text>
				</element>
				<element kind="staticText" uuid="de8e3936-927e-4806-a41a-a38f5a92f1d7" x="405" y="-3" width="144" height="30" fontName="URDU JAMEEL NASTALAIQ" fontSize="12.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
					<paragraph rightIndent="1"/>
					<text><![CDATA[AML / CFT سوالنامہ]]></text>
					<property name="com.jaspersoft.studio.unit.rightIndent" value="px"/>
				</element>
				<element kind="rectangle" uuid="d25847b4-43bd-4457-9064-d82611b68340" x="0" y="27" width="555" height="156" backcolor="#BFE4B7"/>
				<element kind="textField" uuid="36d86dee-7082-43cd-9ad4-7cb33f16111f" mode="Opaque" x="1" y="28" width="218" height="152" backcolor="#BFE4B7" hTextAlign="Justified">
					<expression><![CDATA[$F{HD7}]]></expression>
					<box padding="2"/>
				</element>
				<element kind="rectangle" uuid="211c28db-0882-48e5-bc52-2c9edd075cd6" mode="Opaque" x="230" y="28" width="90" height="154" backcolor="#FFFFFF">
					<pen lineWidth="0.0"/>
				</element>
				<element kind="staticText" uuid="54ec3370-2ae9-4acd-b52f-ea66037cd0e7" x="324" y="28" width="227" height="152" fontName="URDU JAMEEL NASTALAIQ" hTextAlign="Justified">
					<text><![CDATA[کیا آپ یا آپ کے متعلقین میں سے کوئی فرد کسی سیاسی پارٹی میں شامل ہے یا کسی بھی طرح عدلیہ، مسلح افواج، قانون نافذ کرنے والے ادارے یا بیوروکریسی کے لیے کام کرتے ہیں؟ اگر مذکورہ بالا سوال کا جواب ہاں میں ہے تو ازراہِ کرم الگ سے سوالنامہ پُر کریں۔
]]></text>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="1"/>
				</element>
				<element kind="rectangle" uuid="cdcbdbd5-d6ab-4719-8084-9ea2af425a4e" x="0" y="182" width="555" height="128" backcolor="#BFE4B7"/>
				<element kind="textField" uuid="45eeb2aa-9aed-4787-85be-4bd39c9628e8" mode="Opaque" x="1" y="183" width="218" height="126" backcolor="#BFE4B7" hTextAlign="Justified">
					<expression><![CDATA[$F{HD8}]]></expression>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<box padding="2"/>
				</element>
				<element kind="rectangle" uuid="3f34d30b-5112-4492-97ae-b087919a6027" mode="Opaque" x="230" y="183" width="90" height="127" backcolor="#FFFFFF">
					<pen lineWidth="0.0"/>
				</element>
				<element kind="staticText" uuid="1af1f8e3-076a-4dee-bfe3-94b0dc74ca49" x="324" y="182" width="227" height="128" fontName="URDU JAMEEL NASTALAIQ" hTextAlign="Justified">
					<text><![CDATA[کیا آپ کا کوئی مجرمانہ ریکارڈ ہے یا آپ کے خلاف کسی جرم کے سلسلے میں کسی ادارہ میں کوئی کاروائی زیرِ غور ہے؟ یا آپ ملکی مروجہ قانون کے مطابق کسی کالعدم تنظیم سے تعلق رکھتے ہیں؟
]]></text>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
				</element>
				<element kind="textField" uuid="780be68a-9253-4123-97c8-2ced445bd60b" mode="Opaque" x="1" y="311" width="218" height="126" backcolor="#BFE4B7" hTextAlign="Justified">
					<expression><![CDATA[$F{HD9}]]></expression>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<box padding="2"/>
				</element>
				<element kind="staticText" uuid="5ec89f1b-7962-4450-bfaa-c0fffbf788ad" x="324" y="310" width="227" height="84" fontName="URDU JAMEEL NASTALAIQ" hTextAlign="Justified">
					<text><![CDATA[کیا آپ کا کوئی مجرمانہ ریکارڈ ہے یا آپ کے خلاف کسی جرم کے سلسلے میں کسی ادارہ میں کوئی کاروائی زیرِ غور ہے؟ یا آپ ملکی مروجہ قانون کے مطابق کسی کالعدم تنظیم سے تعلق رکھتے ہیں؟]]></text>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
				</element>
				<element kind="rectangle" uuid="7848bc7f-8cbc-44d9-9e3a-7c4834bd284c" mode="Opaque" x="230" y="310" width="90" height="128" backcolor="#FFFFFF">
