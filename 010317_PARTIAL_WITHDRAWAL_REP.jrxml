				<element kind="staticText" uuid="a6e516f6-52dd-4c20-b996-62f3d6ebb08b" x="444" y="64" width="100" height="30" fontName="URDU JAMEEL NASTALAIQ" fontSize="12.0" bold="false" hTextAlign="Right" vTextAlign="Middle">
					<paragraph rightIndent="1"/>
					<text><![CDATA[موثر تاریخ]]></text>
				</element>
