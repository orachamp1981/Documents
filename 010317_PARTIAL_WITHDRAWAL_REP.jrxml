			<element kind="frame" uuid="75e6f0c4-de01-45b9-b492-0aacef8a0a47" x="0" y="337" width="555" height="299">
				<element kind="rectangle" uuid="8a2c9dd5-9729-4a30-bc6f-eb4b581870eb" x="0" y="-3" width="555" height="30" backcolor="#BFE4B7"/>
				<element kind="staticText" uuid="811f537e-6f8b-4f82-a00f-0df0206f0356" x="4" y="0" width="186" height="22" bold="true" hTextAlign="Left" vTextAlign="Middle">
					<text><![CDATA[Perticipant's Declaration]]></text>
				</element>
				<element kind="staticText" uuid="31dc06e2-1e0d-4836-8621-e81d5e90e3a3" x="444" y="-3" width="100" height="30" fontName="URDU JAMEEL NASTALAIQ" fontSize="12.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
					<paragraph rightIndent="1"/>
					<text><![CDATA[شریک  کا  اقرار نامہ ]]></text>
					<property name="com.jaspersoft.studio.unit.rightIndent" value="px"/>
				</element>
				<element kind="rectangle" uuid="d86b40ad-8090-4127-ac4a-26aaae72518b" x="0" y="27" width="555" height="272" backcolor="#FFFFFF"/>
				<element kind="textField" uuid="e1ca973c-6037-4b63-af87-d46e8e5e0c50" x="0" y="28" width="270" height="81" hTextAlign="Justified">
					<expression><![CDATA[$F{HD1}]]></expression>
					<box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="2"/>
				</element>
				<element kind="textField" uuid="dba64456-8cc8-4446-8635-099d55169a62" x="291" y="27" width="263" height="82" fontName="URDU JAMEEL NASTALAIQ" fontSize="10.0" hTextAlign="Justified" vTextAlign="Middle">
					<expression><![CDATA[" میں  "+$F{PARTICIPANT_NAME}+" بطور مذکورہ بالا ممبرشپ کے شریک کے ممبر شپ کے دستاویزات تکافل سیونگ پلان (جی 4) کےمطابق یہ اپنی ممبرشپ میں مورخہ "+ new java.text.SimpleDateFormat("d/M/yyyy").format($F{EFFECTIVE_DATE}) +" سے تبدیلی کی درخواست کرتا ہوں"]]></expression>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
				</element>
				<element kind="textField" uuid="2cad22af-f6ed-423f-a8b1-3382d42276a2" x="0" y="110" width="270" height="71" hTextAlign="Justified">
					<expression><![CDATA[$F{HD2}]]></expression>
					<box padding="4"/>
				</element>
				<element kind="textField" uuid="c01f244e-4be6-4074-8db0-0d4b5f9ab148" x="0" y="181" width="270" height="69" hTextAlign="Justified">
					<expression><![CDATA[$F{HD3}]]></expression>
					<box padding="4"/>
				</element>
				<element kind="textField" uuid="8c7ef381-e0e4-4735-9b8c-f042d67489f4" x="0" y="239" width="270" height="60">
					<expression><![CDATA[$F{HD4}]]></expression>
					<box topPadding="2" leftPadding="4"/>
				</element>
				<element kind="textField" uuid="507c4f9c-f9bc-402e-ac8e-1d135f1635e7" x="291" y="110" width="263" height="71" fontName="URDU JAMEEL NASTALAIQ" hTextAlign="Justified" vTextAlign="Middle">
					<expression><![CDATA["میں Pak-Qatar Family Takaful Limited  (وکیل ) سےمبللغ "+$F{TOT_PARTIAL_WD}+ " روپے بطور جزوی واپسی کی " +$F{BANK_NAME_URDU} + " میں موجود اکاؤنٹ میں ادائیگی کی درخواست کرتا ہوں - یہ واپسی میری منتخب کردہ سرمایہ کاری کی حکمت عملی میں موجود یونٹس کی تلفی کے ذریعے رو بہ عمل ہوگی-"]]></expression>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
				</element>
				<element kind="textField" uuid="b7a3140a-d281-4547-9e3b-2af54a8878ac" x="291" y="179" width="263" height="60" fontName="URDU JAMEEL NASTALAIQ" hTextAlign="Justified" vTextAlign="Middle">
					<expression><![CDATA["مجھے خبردار کیا جا چکا ہے کے جزوی طور پر رقم نکالنا سرٹیفکیٹ میں درج مجموعی تکافل فوائد کی رقم،(موت پر واجب الاداء تکافل کی رقم) کوبشکل متناسب کم کرے گا-"]]></expression>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
				</element>
				<element kind="textField" uuid="2e721713-bdc0-47b2-af39-6e6eb5e2bf0b" x="292" y="240" width="263" height="59" fontName="URDU JAMEEL NASTALAIQ" hTextAlign="Justified" vTextAlign="Middle">
					<expression><![CDATA["میں اس بات کو سمجھتا ہوں کہ شریک کے ممبرشپ کے دستاویزات میں جن شرائط کی وضاحت کی گئی ہے ، جوکہ اس رد وبدل کی درخواست فارم میں استعمال ہوئے ہیں ، ان کے وہی معانی ہونگے جیسا کہ شریک کے کے ممبرشپ کے دستاویزات میں ہیں۔"]]></expression>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
				</element>
				<element kind="line" uuid="d63a48ac-c1e3-4614-8cf6-77f80a13a6cc" x="0" y="109" width="555" height="1">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</element>
				<element kind="line" uuid="486f2721-35fa-461e-89dc-07ebeb66a146" x="0" y="178" width="555" height="1">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</element>
				<element kind="line" uuid="a250d701-e8ed-4d1e-80ad-6eaf99e20570" x="0" y="240" width="555" height="1">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</element>
			</element>
		</band>
		<band height="716">
			<element kind="frame" uuid="449ffecc-d970-4a92-b37a-fc5812cb8602" x="0" y="7" width="555" height="255">
				<element kind="rectangle" uuid="8845b37f-ce3e-458b-a707-6afb725eba37" x="0" y="163" width="555" height="92" backcolor="#BFE4B7"/>
				<element kind="rectangle" uuid="780ee1fa-64df-49fa-8645-a07ad926a32f" x="0" y="-3" width="555" height="30" backcolor="#BFE4B7"/>
				<element kind="staticText" uuid="bf59cbe4-be1a-4b6a-a3fa-1be64427841a" x="4" y="0" width="186" height="22" bold="true" hTextAlign="Left" vTextAlign="Middle">
					<text><![CDATA[Zakat]]></text>
				</element>
				<element kind="staticText" uuid="db41613f-2c23-4905-b8c6-9bfb7df62b74" x="400" y="-3" width="144" height="30" fontName="URDU JAMEEL NASTALAIQ" fontSize="12.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
					<paragraph rightIndent="1"/>
					<text><![CDATA[زکواہ کٹوتی/ استثنئ کا اجازت نامہ]]></text>
					<property name="com.jaspersoft.studio.unit.rightIndent" value="px"/>
				</element>
				<element kind="rectangle" uuid="9dffe292-db6a-46a2-aea3-4f1aa97303aa" x="0" y="70" width="555" height="93" backcolor="#BFE4B7"/>
				<element kind="rectangle" uuid="6b022f99-d794-409a-99b2-a7c7c4511642" x="0" y="27" width="555" height="43" backcolor="#FFFFFF"/>
				<element kind="textField" uuid="1c9b0eb6-a1cf-4e7d-9eae-fd42c1ca59f7" mode="Opaque" x="1" y="71" width="209" height="91" backcolor="#BFE4B7" hTextAlign="Justified">
					<expression><![CDATA[$F{HD6}]]></expression>
					<box padding="4"/>
				</element>
				<element kind="staticText" uuid="4c7afb56-f5a9-4b49-895c-4bf2abee7e6e" x="339" y="28" width="214" height="42" fontName="URDU JAMEEL NASTALAIQ" hTextAlign="Justified">
					<text><![CDATA[میں موجود بینک اکاؤنٹ میں ادا کرے- جزوی طور پر رقم نکالنے کی آمدن زکوۃ کے ساتھ مشروط ہوگی اور میں اسی وجہ سے یہ اقرار کرتا ہوں کہ]]></text>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
				</element>
				<element kind="rectangle" uuid="a52bb126-6a71-4309-9655-8cd8b97b7108" mode="Opaque" x="220" y="71" width="120" height="91" backcolor="#FFFFFF">
					<pen lineWidth="0.0"/>
				</element>
				<element kind="rectangle" uuid="32e0912c-4cc6-4651-bc55-f373e31daf6a" x="257" y="100" width="47" height="28"/>
				<element kind="staticText" uuid="cd77f28b-7b23-45d9-a6d6-481cbf6d2464" x="339" y="164" width="215" height="91" fontName="URDU JAMEEL NASTALAIQ" fontSize="10.0" hTextAlign="Justified">
					<text><![CDATA[زکوۃ کی کٹوتی اور اس کی ادائیگی میری ذمہ داری
نہیں ہوگی، میں اس حوالے سے -50CZ فراہم کر رہا
ہوں۔]]></text>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
				</element>
				<element kind="textField" uuid="a9f58cfa-2b48-4a51-a0f3-a2747a966277" x="1" y="28" width="280" height="42" hTextAlign="Justified">
					<expression><![CDATA[$F{HD5}]]></expression>
					<box padding="4"/>
				</element>
				<element kind="textField" uuid="1151e5eb-619c-4eae-bffb-622489b3de2c" mode="Opaque" x="1" y="164" width="210" height="91" backcolor="#BFE4B7" fontSize="10.0" hTextAlign="Justified">
					<expression><![CDATA[$F{HD7}]]></expression>
					<box padding="4"/>
				</element>
				<element kind="staticText" uuid="634c7061-8f1d-4a69-a782-2b3f20be776a" x="340" y="71" width="215" height="91" fontName="URDU JAMEEL NASTALAIQ" hTextAlign="Justified">
					<text><![CDATA[میری طرف سے زکوۃ کی وصولی اور ادائیگی کا انتظام کیا جائے۔]]></text>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
				</element>
				<element kind="rectangle" uuid="3b603cd1-be2a-48d1-a0a9-04ae09df3ae5" mode="Opaque" x="220" y="164" width="120" height="91" backcolor="#FFFFFF">
					<pen lineWidth="0.0"/>
				</element>
				<element kind="rectangle" uuid="3aacc8e9-e3b7-49e4-997e-0ff6445c0556" x="257" y="193" width="47" height="28"/>
			</element>
			<element kind="frame" uuid="ec0d1911-0ba0-4f02-9a39-65288bc61c28" x="0" y="280" width="555" height="411">
				<element kind="rectangle" uuid="f3452ffe-6766-459a-8155-941830fb31fc" x="0" y="310" width="555" height="117" backcolor="#BFE4B7"/>
				<element kind="rectangle" uuid="9adfd465-1dec-4258-9abc-3bc6018d67ea" x="0" y="-3" width="555" height="30" backcolor="#BFE4B7"/>
				<element kind="staticText" uuid="8996c38c-998e-4269-9d38-85dacc43ac57" x="4" y="0" width="186" height="22" bold="true" hTextAlign="Left" vTextAlign="Middle">
					<text><![CDATA[AML / CFT Questionnaire]]></text>
				</element>
				<element kind="staticText" uuid="622627ef-4b49-4d94-8f5f-0176d2c2720f" x="405" y="-3" width="144" height="30" fontName="URDU JAMEEL NASTALAIQ" fontSize="12.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
					<paragraph rightIndent="1"/>
					<text><![CDATA[AML / CFT سوالنامہ]]></text>
					<property name="com.jaspersoft.studio.unit.rightIndent" value="px"/>
				</element>
				<element kind="rectangle" uuid="83d12546-a2ad-4bf0-ba40-76774dac715f" x="0" y="27" width="555" height="156" backcolor="#BFE4B7"/>
				<element kind="textField" uuid="b62abb58-985a-4c30-8fda-7dd105478859" mode="Opaque" x="1" y="28" width="218" height="152" backcolor="#BFE4B7" hTextAlign="Justified">
					<expression><![CDATA[$F{HD8}]]></expression>
					<box padding="4"/>
				</element>
				<element kind="rectangle" uuid="e2144d53-f16c-4e3f-8e59-4b3f35de6fce" mode="Opaque" x="230" y="28" width="90" height="154" backcolor="#FFFFFF">
					<pen lineWidth="0.0"/>
				</element>
				<element kind="staticText" uuid="d6358f9d-de4a-440b-910e-4d96d4cbd993" x="324" y="28" width="227" height="152" fontName="URDU JAMEEL NASTALAIQ" hTextAlign="Justified">
					<text><![CDATA[کیا آپ یا آپ کے متعلقین میں سے کوئی فرد کسی سیاسی پارٹی میں شامل ہے یا کسی بھی طرح عدلیہ، مسلح افواج، قانون نافذ کرنے والے ادارے یا بیوروکریسی کے لیے کام کرتے ہیں؟ اگر مذکورہ بالا سوال کا جواب ہاں میں ہے تو ازراہِ کرم الگ سے سوالنامہ پُر کریں۔
]]></text>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="1"/>
				</element>
				<element kind="rectangle" uuid="cb622463-93a8-446b-aaf1-75dfcfb5e67e" x="0" y="182" width="555" height="128" backcolor="#BFE4B7"/>
				<element kind="textField" uuid="8a4fd1fe-d8d4-4440-b83c-26a0da3db6d9" mode="Opaque" x="1" y="183" width="218" height="126" backcolor="#BFE4B7" hTextAlign="Justified">
					<expression><![CDATA[$F{HD9}]]></expression>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<box padding="4"/>
				</element>
				<element kind="rectangle" uuid="9ac583e7-e155-43cb-b918-97fd132717b1" mode="Opaque" x="230" y="183" width="90" height="127" backcolor="#FFFFFF">
					<pen lineWidth="0.0"/>
				</element>
				<element kind="staticText" uuid="189833b8-fda4-466c-b1a7-d4c9554dc40d" x="324" y="182" width="227" height="128" fontName="URDU JAMEEL NASTALAIQ" hTextAlign="Justified">
					<text><![CDATA[کیا آپ کا کوئی مجرمانہ ریکارڈ ہے یا آپ کے خلاف کسی جرم کے سلسلے میں کسی ادارہ میں کوئی کاروائی زیرِ غور ہے؟ یا آپ ملکی مروجہ قانون کے مطابق کسی کالعدم تنظیم سے تعلق رکھتے ہیں؟
]]></text>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
				</element>
				<element kind="textField" uuid="e3f18889-5c6d-4cb9-a01c-4a2d7e8febe6" mode="Opaque" x="1" y="311" width="218" height="115" backcolor="#BFE4B7" hTextAlign="Justified">
