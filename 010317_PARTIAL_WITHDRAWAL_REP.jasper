	<parameter name="DOCUMENT_ID" class="java.lang.Integer"/>
	<parameter name="sdate" class="java.lang.String"/>
	<parameter name="edate" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[--Partial Withdrawal Form
select document_id_pk,membership_no,
       'Alteration Request Form to the Membership no. '||membership_no membershipno,
       type_of_plan Product_Rider,
       alteration_no,
       membership_alteration,
       --alteration_id_pk,
       effective_date,
       tot_partial_wd,
       new_freq_payment,
       new_contribution,
       pq_acc_no,
       bank_acc_no,
       bank_name,
       participant_name,
       initcap(residential_address||' '||city_name||','||province_name||' '||country_name) residential_address,
       cnic_no,
       dob,
       gender,
       mobile_no,
       residential_contact,
       type_of_plan,
       calendar,
       commencement_date,
       membership_term,
       maturity_date,
       'I, '||participant_name||', as the Participant of the Membership mentioned above, hereby request in accordance with the Participant''s Membership Document applicable to the '||type_of_plan||', to alter my Membership as of '||effective_date||'.' hd1,
'I request Pak-Qatar Family Takaful Limited (Wakeel) to perform the Partial Withdrawal Alteration of Rs. '||tot_partial_wd||' by redemption of units of my selected Participant Investment Strategies and to pay the Partial Withdrawal Proceeds in my bank account with '||bank_name||'.' hd2,
'I was informed and I agree that the Partial Withdrawal Alteration will reduce the Total Takaful Benefits Amount as indicated on the Participant''s Specific Schedule for the calculation of Amount Payable Upon Death proportionally.' hd3,
'I understand that the Defined Terms in the Participant''s Membership Document, which are used in this Alteration Request Form, shall have the same meaning as in the Participant''s Membership Document.' hd4,
'Withdrawal Proceeds are subject to Zakat' hd5,
'I, '||participant_name||', as Participant in the '||type_of_plan||', authorize the Wakeel to arrange for the collection and payment of Zakat on my behalf.' hd6,
'I, '||participant_name||', as Participant in the '||type_of_plan||', hereby declare not to deduct Zakat and payment of Zakat will be my responsibility. I am providing the CZ-50 in this regard.' hd7,
'Are you or any of your associate (immediate family member) affiliated with any Political Party, or works for the Judiciary, Armed Forces, Law Enforcement Agency or Bureaucracy in any possible way?If the reply to the aforementioned has been given in affirmation then complete a separate 

Answer:' hd8,
'Do you have any criminal record or have any criminal proceedings pending against you before any adjudicating forum(s) or are you a part of any banned outfit as per the prevailing laws of the Land?

Answer:' hd9,
'Are you in any way engaged in any sort of business activities with the countries being marked as AML non-compliant by the FATF or UN? If yes, then please share the details.

Answer:' hd10,
USER_NAME,bank_name,bank_name_urdu

  from (select a.document_id_pk,a.document_code membership_no,
               /*(select count(v1.alteration_code)
                  from vu_alteraiion v1
                 where v1.document_code = a.document_code
                   and v1.alteration_id_pk < c.alteration_id_pk)*/0 alteration_no,
                   --c.alteration_id_pk,
               'Partial Withdrawal' membership_alteration,
               trunc(sysdate) effective_date,
               (select to_char(nvl(sum(abs(v2.transaction_amount)), 0),'FM999G999G999G990D00')
          from epf_acc_transaction v1, epf_acc_transaction_dtl v2
         where v1.transaction_id_pk = v2.transaction_id_fk
           and v1.transaction_flag = 'W'
           and v1.document_id_fk = a.document_id_pk
           and v2.employee_id_fk = b.employee_id_pk
           --and v1.document_id_fk = :DOCUMENT_ID
           )                tot_partial_wd,
               (select a1.setup_description
                  from vu_setup_category_detail a1
                 where 1 = 1
                   and a1.setup_category_id_pk = 10
                   and a1.setup_dtl_id_pk = b.mode_of_payment_id) new_freq_payment,
                   (select min(y3.DUE_DATE)
          from vu_payment_scheduler y3
         where y3.document_id_fk = a.document_id_pk
           and y3.employee_id_pk = b.employee_id_pk
           and upper(y3.PAYMENT_STATUS) = 'DUE')  next_cont_due_dt,
           (select max(y2.PAID_DATE)
          from vu_payment_scheduler y2
         where y2.document_id_fk = a.document_id_pk
           and y2.employee_id_pk = b.employee_id_pk) last_cont_paid_dt,
                   b.contribution new_contribution,
                   bk.account_no_pqftl pq_acc_no,
               b.account_no bank_acc_no,
               a.policy_bank_id,
               initcap(b.emp_title||' '||trim(b.employee_name)) participant_name,
                b.emp_address residential_address,p1.city_id_fk,
       initcap(nvl((select ct.city_name
       from epf_gen_st_city ct where ct.city_id_pk = p1.city_id_fk),p1.m_city)) city_name,p1.m_city, p1.country_code,
       (select initcap(pr.province_name) from epf_gen_st_province pr
       where pr.province_id_pk in (select distinct ct1.province_id_fk from epf_gen_st_city ct1 where ct1.city_id_pk = p1.city_id_fk)) province_name,
       (select initcap(cn.setup_description) from epf_gen_st_setup_category_dtl cn
       where cn.setup_dtl_id_pk = p1.country_code
       and cn.setup_category_id_fk = 25) country_name,
               b.cnic_no,
               b.dob,
               decode(b.gender,'M','Male','F','Female') gender,
               b.mobile_no,
               b.phone_no residential_contact,
               d.prod_type_name type_of_plan,
               'Gregorian' calendar,
               a.period_from commencement_date,
               a.contribution_term membership_term,
               a.period_to maturity_date,
               (SELECT USER_ID
                 FROM SM_USERS SM WHERE USER_ID_PK =1) USER_NAME,
                 bk.bank_name,
                 bk.bank_name_urdu
               --,c.alteration_type_id_fk
          from epf_uw_document         a,
               epf_uw_employees        b,
               --vu_alteraiion           c,
               epf_gen_st_product_type d,
               epf_gen_st_participant p1,
               epf_gen_st_bank        bk
         where 1 = 1
           and a.document_id_pk = b.document_id_fk
           --and a.document_code = c.document_code
           and a.product_type_id_fk = d.prod_type_id_pk
           and a.participant_id_fk = p1.participant_id_pk
           and a.policy_bank_id=bk.bank_id_pk
           and b.emp_status_id_fk in ('39','821','931') 
         --and c.ALTERATION_ID_PK in (select max(alteration_id_pk) from vu_alteraiion v1 where v1.DOCUMENT_CODE = a.document_code)
         --and a.document_id_pk =&DOCUMENT_ID
         
         and a.document_id_pk = $P{DOCUMENT_ID}
           )]]>
	</queryString>
