					</textElement>
					<text><![CDATA[AML / CFT سوالنامہ]]></text>
				</staticText>
				<rectangle>
					<reportElement x="0" y="27" width="555" height="156" backcolor="#BFE4B7" uuid="83d12546-a2ad-4bf0-ba40-76774dac715f"/>
				</rectangle>
				<textField>
					<reportElement mode="Opaque" x="1" y="28" width="218" height="152" backcolor="#BFE4B7" uuid="b62abb58-985a-4c30-8fda-7dd105478859"/>
					<box padding="4"/>
					<textElement textAlignment="Justified"/>
					<textFieldExpression><![CDATA[$F{HD8}]]></textFieldExpression>
				</textField>
				<rectangle>
					<reportElement mode="Opaque" x="230" y="28" width="90" height="154" backcolor="#FFFFFF" uuid="e2144d53-f16c-4e3f-8e59-4b3f35de6fce"/>
					<graphicElement>
						<pen lineWidth="0.0"/>
					</graphicElement>
				</rectangle>
				<staticText>
					<reportElement x="324" y="28" width="227" height="152" uuid="d6358f9d-de4a-440b-910e-4d96d4cbd993"/>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="1"/>
					<textElement textAlignment="Justified">
						<font fontName="URDU JAMEEL NASTALAIQ"/>
					</textElement>
					<text><![CDATA[کیا آپ یا آپ کے متعلقین میں سے کوئی فرد کسی سیاسی پارٹی میں شامل ہے یا کسی بھی طرح عدلیہ، مسلح افواج، قانون نافذ کرنے والے ادارے یا بیوروکریسی کے لیے کام کرتے ہیں؟ اگر مذکورہ بالا سوال کا جواب ہاں میں ہے تو ازراہِ کرم الگ سے سوالنامہ پُر کریں۔
]]></text>
				</staticText>
				<rectangle>
					<reportElement x="0" y="182" width="555" height="128" backcolor="#BFE4B7" uuid="cb622463-93a8-446b-aaf1-75dfcfb5e67e"/>
				</rectangle>
				<textField>
					<reportElement mode="Opaque" x="1" y="183" width="218" height="126" backcolor="#BFE4B7" uuid="8a4fd1fe-d8d4-4440-b83c-26a0da3db6d9">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
					</reportElement>
					<box padding="4"/>
					<textElement textAlignment="Justified"/>
					<textFieldExpression><![CDATA[$F{HD9}]]></textFieldExpression>
				</textField>
				<rectangle>
					<reportElement mode="Opaque" x="230" y="183" width="90" height="127" backcolor="#FFFFFF" uuid="9ac583e7-e155-43cb-b918-97fd132717b1"/>
					<graphicElement>
						<pen lineWidth="0.0"/>
					</graphicElement>
				</rectangle>
				<staticText>
					<reportElement x="324" y="182" width="227" height="128" uuid="189833b8-fda4-466c-b1a7-d4c9554dc40d"/>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
					<textElement textAlignment="Justified">
						<font fontName="URDU JAMEEL NASTALAIQ"/>
					</textElement>
					<text><![CDATA[کیا آپ کا کوئی مجرمانہ ریکارڈ ہے یا آپ کے خلاف کسی جرم کے سلسلے میں کسی ادارہ میں کوئی کاروائی زیرِ غور ہے؟ یا آپ ملکی مروجہ قانون کے مطابق کسی کالعدم تنظیم سے تعلق رکھتے ہیں؟
]]></text>
				</staticText>
				<textField>
					<reportElement mode="Opaque" x="1" y="311" width="218" height="115" backcolor="#BFE4B7" uuid="e3f18889-5c6d-4cb9-a01c-4a2d7e8febe6">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
					</reportElement>
					<box padding="4"/>
					<textElement textAlignment="Justified"/>
					<textFieldExpression><![CDATA[$F{HD10}]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement x="324" y="310" width="227" height="84" uuid="1b7189b9-06ce-4273-8daa-d3c17ad535f0"/>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
					<textElement textAlignment="Right">
						<font fontName="URDU JAMEEL NASTALAIQ"/>
					</textElement>
					<text><![CDATA[کیا آپ کسی بھی طرح کسی ایسے ملک کے ساتھ کاروباری سرگرمی میں ملوث ہیں جو فائنانشل ایکشن ٹاسک فورس اور اقوامِ متحدہ کی جانب سے اینٹی منی لانڈرنگ کی نان کمپلائنٹ لسٹ میں شامل ہے؟ اگر ہاں تو تفصیل مہیا کریں۔]]></text>
				</staticText>
				<rectangle>
