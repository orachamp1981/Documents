				</rectangle>
				<textField>
					<reportElement mode="Opaque" x="1" y="71" width="209" height="91" backcolor="#BFE4B7" uuid="1c9b0eb6-a1cf-4e7d-9eae-fd42c1ca59f7"/>
					<box padding="4"/>
					<textElement textAlignment="Justified"/>
					<textFieldExpression><![CDATA[$F{HD6}]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement x="339" y="28" width="214" height="42" uuid="4c7afb56-f5a9-4b49-895c-4bf2abee7e6e"/>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
					<textElement textAlignment="Justified">
						<font fontName="URDU JAMEEL NASTALAIQ"/>
					</textElement>
					<text><![CDATA[میں موجود بینک اکاؤنٹ میں ادا کرے- جزوی طور پر رقم نکالنے کی آمدن زکوۃ کے ساتھ مشروط ہوگی اور میں اسی وجہ سے یہ اقرار کرتا ہوں کہ]]></text>
				</staticText>
				<rectangle>
					<reportElement mode="Opaque" x="220" y="71" width="120" height="91" backcolor="#FFFFFF" uuid="a52bb126-6a71-4309-9655-8cd8b97b7108"/>
					<graphicElement>
						<pen lineWidth="0.0"/>
					</graphicElement>
				</rectangle>
				<rectangle>
					<reportElement x="257" y="100" width="47" height="28" uuid="32e0912c-4cc6-4651-bc55-f373e31daf6a"/>
				</rectangle>
				<staticText>
					<reportElement x="339" y="164" width="215" height="91" uuid="cd77f28b-7b23-45d9-a6d6-481cbf6d2464"/>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
					<textElement textAlignment="Justified">
						<font fontName="URDU JAMEEL NASTALAIQ" size="10"/>
					</textElement>
					<text><![CDATA[زکوۃ کی کٹوتی اور اس کی ادائیگی میری ذمہ داری
نہیں ہوگی، میں اس حوالے سے -50CZ فراہم کر رہا
ہوں۔]]></text>
				</staticText>
				<textField>
					<reportElement x="1" y="28" width="280" height="42" uuid="a9f58cfa-2b48-4a51-a0f3-a2747a966277"/>
