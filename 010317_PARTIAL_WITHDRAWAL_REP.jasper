				<rectangle>
					<reportElement x="0" y="27" width="555" height="272" backcolor="#FFFFFF" uuid="d86b40ad-8090-4127-ac4a-26aaae72518b"/>
				</rectangle>
				<textField>
					<reportElement x="0" y="28" width="270" height="81" uuid="e1ca973c-6037-4b63-af87-d46e8e5e0c50"/>
					<box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="2"/>
					<textElement textAlignment="Justified"/>
					<textFieldExpression><![CDATA[$F{HD1}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="291" y="27" width="263" height="82" uuid="dba64456-8cc8-4446-8635-099d55169a62"/>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
					<textElement textAlignment="Justified" verticalAlignment="Middle">
						<font fontName="URDU JAMEEL NASTALAIQ" size="10"/>
					</textElement>
					<textFieldExpression><![CDATA[" میں  "+$F{PARTICIPANT_NAME}+" بطور مذکورہ بالا ممبرشپ کے شریک کے ممبر شپ کے دستاویزات تکافل سیونگ پلان (جی 4) کےمطابق یہ اپنی ممبرشپ میں مورخہ "+ new java.text.SimpleDateFormat("d/M/yyyy").format($F{EFFECTIVE_DATE}) +" سے تبدیلی کی درخواست کرتا ہوں"]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="0" y="110" width="270" height="71" uuid="2cad22af-f6ed-423f-a8b1-3382d42276a2"/>
					<box padding="4"/>
					<textElement textAlignment="Justified"/>
					<textFieldExpression><![CDATA[$F{HD2}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="0" y="181" width="270" height="69" uuid="c01f244e-4be6-4074-8db0-0d4b5f9ab148"/>
					<box padding="4"/>
					<textElement textAlignment="Justified"/>
					<textFieldExpression><![CDATA[$F{HD3}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="0" y="239" width="270" height="60" uuid="8c7ef381-e0e4-4735-9b8c-f042d67489f4"/>
					<box topPadding="2" leftPadding="4"/>
					<textFieldExpression><![CDATA[$F{HD4}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="291" y="110" width="263" height="71" uuid="507c4f9c-f9bc-402e-ac8e-1d135f1635e7"/>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
					<textElement textAlignment="Justified" verticalAlignment="Middle">
						<font fontName="URDU JAMEEL NASTALAIQ"/>
					</textElement>
					<textFieldExpression><![CDATA["میں Pak-Qatar Family Takaful Limited  (وکیل ) سےمبللغ "+$F{TOT_PARTIAL_WD}+ " روپے بطور جزوی واپسی کی " +$F{BANK_NAME_URDU} + " میں موجود اکاؤنٹ میں ادائیگی کی درخواست کرتا ہوں - یہ واپسی میری منتخب کردہ سرمایہ کاری کی حکمت عملی میں موجود یونٹس کی تلفی کے ذریعے رو بہ عمل ہوگی-"]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="291" y="179" width="263" height="60" uuid="b7a3140a-d281-4547-9e3b-2af54a8878ac"/>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
					<textElement textAlignment="Justified" verticalAlignment="Middle">
						<font fontName="URDU JAMEEL NASTALAIQ"/>
					</textElement>
					<textFieldExpression><![CDATA["مجھے خبردار کیا جا چکا ہے کے جزوی طور پر رقم نکالنا سرٹیفکیٹ میں درج مجموعی تکافل فوائد کی رقم،(موت پر واجب الاداء تکافل کی رقم) کوبشکل متناسب کم کرے گا-"]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="292" y="240" width="263" height="59" uuid="2e721713-bdc0-47b2-af39-6e6eb5e2bf0b"/>
					<box topPadding="5" leftPadding="2" bottomPadding="2" rightPadding="4"/>
					<textElement textAlignment="Justified" verticalAlignment="Middle">
						<font fontName="URDU JAMEEL NASTALAIQ"/>
					</textElement>
					<textFieldExpression><![CDATA["میں اس بات کو سمجھتا ہوں کہ شریک کے ممبرشپ کے دستاویزات میں جن شرائط کی وضاحت کی گئی ہے ، جوکہ اس رد وبدل کی درخواست فارم میں استعمال ہوئے ہیں ، ان کے وہی معانی ہونگے جیسا کہ شریک کے کے ممبرشپ کے دستاویزات میں ہیں۔"]]></textFieldExpression>
				</textField>
				<line>
					<reportElement x="0" y="109" width="555" height="1" uuid="d63a48ac-c1e3-4614-8cf6-77f80a13a6cc">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
					</reportElement>
				</line>
				<line>
